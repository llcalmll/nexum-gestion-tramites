// Nexum Tránsito: un solo Worker con la app (archivos estáticos) + la API /api/* + D1 + R2.
// Cuenta de Cloudflare: usuario@ejemplo.com. Usar siempre `node scripts/wrangler.mjs ...` (sesión aparte).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexum",
  // Cuenta usuario@ejemplo.com. Si la sesión es de otra cuenta, wrangler falla en vez de desplegar allá.
  "account_id": "TU_ACCOUNT_ID",
  "main": "./api/indice.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // La API pasa siempre por el Worker; lo demás son archivos estáticos (gratis, no cuentan como petición).
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Aviso diario (11:30 UTC = 6:30 a. m. en Colombia): vencimientos y resumen de la bandeja; y WhatsApp cada 5 minutos (archivos,
  // clasificación y propuestas). El plan gratis permite 5 por cuenta; se usan 2.
  "triggers": { "crons": ["30 11 * * *", "*/5 * * * *"] },
  // Workers AI: la voz del asistente (Whisper). Incluido en el plan gratis (10.000 neuronas al día, ~200 min de audio).
  "ai": { "binding": "AI" },
  // Dirección principal. Cloudflare crea el registro DNS y el certificado al desplegar.
  "routes": [{ "pattern": "app.ejemplo.com", "custom_domain": true }],
  // Con rutas, workers.dev se apagaría sola; se deja encendida durante la transición (Access también la cubre).
  "workers_dev": true,
  // Sin direcciones de prueba por versión: Access cubre solo las direcciones fijas.
  "preview_urls": false,
  "vars": {
    // Único correo con acceso. Cloudflare Access lo verifica con un PIN y el Worker lo vuelve a comprobar.
    "CORREO_PERMITIDO": "usuario@ejemplo.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexum",
      "database_id": "TU_DATABASE_ID",
      "migrations_dir": "migraciones"
    }
  ],
  // Documentos, fotos y media de WhatsApp. Nada de archivos dentro de D1.
  "r2_buckets": [
    { "binding": "ARCHIVOS", "bucket_name": "nexum-archivos" }
  ]
}
